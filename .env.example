# ===========================================
# GitHub Reports & CSV Enhancement - Configuration
# ===========================================

# Required API Keys
GITHUB_AUTH_TOKEN=your_github_personal_access_token_here
OPENAI_API_KEY=your_ai_api_key_here

# API Configuration
API_URL="https://api.kluster.ai/v1/chat/completions"
AI_MODEL="meta-llama/Llama-4-Maverick-17B-128E-Instruct-FP8"

PROMPT_DEFAULT="You will receive a CSV dataset below. For Description column, generate a concise description under 15 words based on the data from the description column. Return the full updated CSV, with updated description field with the new description. Don't change any other column. Only respond with CSV, no explanation or extra text."

PROMPT_FORMAT="You will receive a CSV dataset below. Review and sort them per reviewer and assignee. Return the results in a .TXT file, listing only open PRs grouped by reviewer. Each PR should be listed in a bullet point format with its PR URL.

Rules:
- Include only open PRs.
- If a GitHub handle appears as both reviewer and assignee, treat them as the reviewer.
- Also for each person who is a reviewer, sort PRs by project/repo.
- Only include PRs where the assignee is one of the following: eshaben, Telucero, dawnkelly09 and 0xlukem.
- Ignore PRs assigned to anyone else.
- If for some PRs noone isassigned, sort them below in the same format. 
- Do not include any explanation or extra output—only return the formatted .TXT file."

PROMPT_CATEGORIZE="You will receive a CSV dataset below. For Description column, add a category prefix like [BUG], [FEATURE], [DOCS], [SETUP] etc. based on the content. Return the full updated CSV, with updated description field with the categorized description. Don't change any other column. Only respond with CSV, no explanation or extra text."

# For polkadot PRs/issues
POLKADOT_REPOS="paritytech/hardhat-polkadot,paritytech/revive"
POLKADOT_AUTHORS="nhussein11,albertov19,sekisamu,0xLucca,jubeira"

# For PaperMoon PRs/issues
PAPERMOON_REPOS="papermoonio/kluster-mkdocs,papermoonio/tanssi-mkdocs,papermoonio/wormhole-mkdocs,papermoonio/polkadot-mkdocs,papermoonio/moonbeam-mkdocs,kluster-ai/docs,moondance-labs/tanssi-docs,polkadot-developers/polkadot-docs,wormhole-foundation/wormhole-docs,moonbeam-foundation/moonbeam-docs"
PAPERMOON_AUTHORS="brunopgalvao,nhussein11,albertov19,sekisamu,themacexpert,eshaben,ilariae,augustocollado,martin0995,DrZuzzjen,Telucero,dawnkelly09,kapetan3sid,0xlukem,ibbar"
